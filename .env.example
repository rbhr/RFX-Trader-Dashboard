# Database (used by docker-compose and the app)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-rfx
DATABASE_URL=mysql://rfx:change-me-rfx@mysql:3306/rfx_trader

# Auth
JWT_SECRET=generate-a-64-char-random-string
VITE_APP_ID=your-app-id
OAUTH_SERVER_URL=https://your-oauth-provider
OWNER_OPEN_ID=your-owner-open-id

# MetaCopier
METACOPIER_API_KEY=your-key
METACOPIER_ACCOUNT_ID=your-account-id

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token
# Optional: channel that gets an English copy of the risk messages sent to traders
# (equity breaches, daily loss limits, lot/trade-limit closes, missed trades).
# Numeric chat id (-100...) or @channelusername; the bot must be a channel admin.
TELEGRAM_ALERT_CHANNEL_ID=

# Domain (used by Caddy for automatic HTTPS)
DOMAIN=dashboard.yourdomain.com
